<?xml version="1.0"?>
<package format="2">
  <name>d_task_uav_control</name>
  <version>0.1.0</version>
  <description>D-task UAV positioning, tracking, and mission control.</description>

  <maintainer email="orangepi@example.com">orangepi</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>ego_api</depend>
  <depend>jsoncpp</depend>
  <depend>mavros_msgs</depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>uav_protocol_gateway</exec_depend>
  <test_depend>python3-nose</test_depend>

  <export/>
</package>
