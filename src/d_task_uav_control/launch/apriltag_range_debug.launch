<launch>
  <arg name="config_file"
       default="$(find d_task_uav_control)/config/d_task_uav.yaml"/>
  <arg name="start_camera" default="true"/>
  <arg name="video_device"
       default="/dev/v4l/by-id/usb-DCX-250107-ZW_DECXIN-video-index0"/>
  <arg name="image_width" default="640"/>
  <arg name="image_height" default="480"/>
  <arg name="framerate" default="30"/>
  <arg name="pixel_format" default="yuyv"/>
  <arg name="apriltag_id" default="0"/>
  <arg name="apriltag_size_m" default="0.080"/>

  <!-- 只读测距入口：不启动 ego_bridge、任务状态机、MQTT 或投放执行器。 -->
  <node if="$(arg start_camera)"
        pkg="usb_cam" type="usb_cam_node" name="usb_cam"
        ns="usb_camera_vision" output="screen">
    <param name="video_device" value="$(arg video_device)"/>
    <param name="image_width" value="$(arg image_width)"/>
    <param name="image_height" value="$(arg image_height)"/>
    <param name="framerate" value="$(arg framerate)"/>
    <param name="pixel_format" value="$(arg pixel_format)"/>
    <param name="camera_frame_id" value="usb_camera_link"/>
    <param name="camera_name" value="head_camera"/>
    <param name="camera_info_url"
           value="file://$(find d_task_uav_control)/config/decxin_640x480.yaml"/>
    <param name="io_method" value="mmap"/>
  </node>

  <node pkg="d_task_uav_control" type="apriltag_detector_node"
        name="apriltag_range_debug" output="screen">
    <rosparam command="load" file="$(arg config_file)"/>
    <param name="apriltag/tag_id" value="$(arg apriltag_id)"/>
    <param name="apriltag/tag_size_m" value="$(arg apriltag_size_m)"/>
  </node>
</launch>
